{
  "version": 2,
  "builds": [
    {
      "src": "frontend-mern/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "backend-python/main.py",
      "use": "@vercel/python"
    }
  ],
  "rewrites": [
    {
      "source": "/api(.*)",
      "destination": "backend-python/main.py"
    },
    {
      "source": "/uploads(.*)",
      "destination": "backend-python/main.py"
    },
    {
      "source": "/(.*)",
      "destination": "frontend-mern/dist/$1"
    }
  ]
}
